# Terraform CLI config for the lab's coderd. It points provider installation at
# the offline filesystem mirror (populated by `lab/providers.sh` during `make lab-up`), so
# `terraform init` never reaches registry.terraform.io -- which it could not
# anyway, on an internal network. This is the same air-gapped pattern Coder
# documents for real deployments.
#
# Copyright 2026 Optimus Labs (Civilizations research team). Apache-2.0.

provider_installation {
  filesystem_mirror {
    path    = "/lab/mirror"
    include = ["registry.terraform.io/*/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}
